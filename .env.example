# Configurar en el entorno del servidor; no subir claves a GitHub.
# Local: SQLite en data/ivz.sqlite3. Vercel: PostgreSQL obligatorio.
DATABASE_URL=
GEMINI_API_KEY=
# Elegir un modelo con cuota disponible en el proyecto de Google AI Studio.
GEMINI_MODEL=gemini-3.8-flash
# 1 para HTTPS; 0 sólo para localhost.
COOKIE_SECURE=0
# Código de ingreso por correo (doble verificación). Sin estas variables, en local el código se imprime en la consola.
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend.
MAIL_FROM=IVZ Sustainability Hub <acceso@tudominio.com>
# Correo de la cuenta admin (sólo se asigna si todavía no tiene uno).
ADMIN_EMAIL=
# Duración de la sesión después de verificar el código (horas). 720 = 30 días; con licencias vendidas, 8.
SESSION_HOURS=720
