# Configurar en el entorno del servidor; no subir claves a GitHub.
# Local: SQLite en data/ivz.sqlite3. Vercel y contenedor (HUB_ENV=production): PostgreSQL obligatorio.
DATABASE_URL=
GEMINI_API_KEY=
# Elegir un modelo con cuota disponible en el proyecto de Google AI Studio.
GEMINI_MODEL=gemini-3.8-flash
# 1 para HTTPS; 0 sólo para localhost. En Vercel y con HUB_ENV=production siempre es Secure.
COOKIE_SECURE=0
# Dirección de IVZ Carbon para la integración (cambiarla si Carbon se muda de Vercel).
CARBON_API_BASE=https://ivzcarbon.vercel.app
# Sólo para docker compose: contraseña del PostgreSQL local del contenedor.
HUB_DB_PASSWORD=
