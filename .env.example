# Configurar en el entorno del servidor; no subir claves a GitHub.
# Local: SQLite en data/ivz.sqlite3. Vercel: PostgreSQL obligatorio.
DATABASE_URL=
GEMINI_API_KEY=
# Elegir un modelo con cuota disponible en el proyecto de Google AI Studio.
GEMINI_MODEL=gemini-3.8-flash
# 1 para HTTPS; 0 sólo para localhost.
COOKIE_SECURE=0
